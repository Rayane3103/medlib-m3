{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedLib M3",
  "version": "0.1.3",
  "identifier": "com.medlib.m3",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MedLib M3",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "mobile-scanner/index.html": "mobile-scanner/index.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5RjIxNTREQzNBMEI4ODYKUldTR3VLRERUUlh5NmZsbkE0Ukc1UnBSV1BSM09GajNBK1A2bVI3dElCNitiaGRSb0xpWW9mR3cK",
      "endpoints": [
        "https://github.com/Rayane3103/medlib-m3/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
